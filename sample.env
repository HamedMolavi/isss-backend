NODE_ENV=
PORT_HTTP=
PORT_HTTPS=
HOST=
BASE_URL=
# MONGODB_URL=
MONGODB_URL=
# REDIS_URL=
REDIS_URL=
# ELASTIC_SEARCH=
ELASTIC_SEARCH=
FACE_INDEX=
PLATE_INDEX=
HUMAN_INDEX=
SABOTAGE_INDEX=
REQUEST_LOG_DIR=
RECORD_STREAM_TIME=
SESSION_SECRET=
TREACKER_SEARCH_URL=
MODELS=
KAFKA_BOOTSTRAP=
MAX_LOAD=
LOGTYPES=
MDPATH=
SIGNAL_TOPIC=
SIGNAL_KEY=
MAX_CAMERAS=
SQLITE_PATH=

# Kafka Configuration
# Timeout for face recognition AI service responses (in milliseconds)
# Default: 30000 (30 seconds) - Increase if AI service requires more time
KAFKA_AI_TIMEOUT=30000

# MinIO / S3 Configuration
MINIO_ENDPOINT=http://192.168.100.100:9000
MINIO_ROOT_USER=your-access-key
MINIO_ROOT_PASSWORD=your-secret-key

# Log Integrity Configuration
LOG_INTEGRITY_TOPIC=log-integrity-alerts

# Log Backup Configuration
LOG_TTL_DAYS=60
BACKUP_INTERVAL_DAYS=30
BACKUP_CHECK_INTERVAL_HOURS=24
BACKUP_DIR_PATH=

# FTP Configuration for Automatic Backup (Optional)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=false
FTP_PATH=/backups

# Go2RTC Configuration
GO2RTC_BASE_URL=http://localhost:1984
GO2RTC_RTSP_PORT=8554
