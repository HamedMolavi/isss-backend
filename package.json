  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ariapa/isss-backend/issues"
  },
  "homepage": "https://github.com/Ariapa/isss-backend#readme",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/redis": "^4.0.11"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.1",
    "axios": "^1.8.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "image-size": "^2.0.1",
    "jalaali-js": "^1.2.8",
    "jalali-moment": "^3.3.11",
    "jimp": "^1.6.0",
    "moment-timezone": "^0.5.47",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "node-onvif": "^0.1.7",
    "persian-date": "^1.1.0",
    "random-words-es": "^1.1.1",
    "redis": "^4.7.0"
