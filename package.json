{
  "name": "isss-plate-controller-backend",
  "version": "0.1.0",
  "description": "## build",
  "main": "src/server.ts",
  "scripts": {
    "start": "npx ts-node ./src/server.ts",
    "build": "npx tsc -p .",
    "start:prod": "yarn build && node ./build/server.js",
    "dev": "npx nodemon ./src/server.ts",
    "test:unit": "mocha ./build/test/unitTest/models ",
    "test:tools": "mocha ./build/test/unitTest/tools ",
    "test:api": "mocha --timeout 10000 ./build/test/endpointTest/cameraRoutes.test.js",
    "docker:build": "docker build -t isss-backend .",
    "docker:run": "docker run -e .env -p 8000:3000 -d isss-backend"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Ariapa/isss-backend.git"
  },
